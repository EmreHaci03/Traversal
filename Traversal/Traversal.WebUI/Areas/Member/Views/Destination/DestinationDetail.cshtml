@model GetDestinationByIdDto
@{
    ViewData["Title"] = Model.City;
    Layout = "~/Areas/Member/Views/Shared/_MemberLayout.cshtml";
}
<style>
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13.5px;
        color: #888;
        text-decoration: none;
        margin-bottom: 20px;
    }

        .back-link:hover {
            color: #e67e22;
        }

    .detail-hero {
        border-radius: 18px;
        overflow: hidden;
        position: relative;
        height: 320px;
        margin-bottom: 24px;
    }

        .detail-hero img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .detail-hero .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.75), rgba(0,0,0,0.05));
            display: flex;
            align-items: flex-end;
            padding: 32px;
        }

        .detail-hero .hero-info h2 {
            color: #fff;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .detail-hero .hero-info .meta-badges {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

            .detail-hero .hero-info .meta-badges span {
                background: rgba(255,255,255,0.15);
                backdrop-filter: blur(4px);
                color: #fff;
                font-size: 13px;
                padding: 6px 14px;
                border-radius: 20px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

    .detail-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
    }

    @@media (max-width: 900px) {
        .detail-grid {
            grid-template-columns: 1fr;
        }
    }

    .detail-section {
        background: #fff;
        border-radius: 16px;
        padding: 28px 32px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 20px;
    }

        .detail-section h5 {
            font-size: 16px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .detail-section h5 i {
                color: #e67e22;
            }

        .detail-section p {
            font-size: 14.5px;
            color: #555;
            line-height: 1.8;
        }

        .detail-section .second-image {
            margin-top: 18px;
            border-radius: 12px;
            overflow: hidden;
        }

            .detail-section .second-image img {
                width: 100%;
                height: 220px;
                object-fit: cover;
            }

    .price-sidebar {
        background: #fff;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        position: sticky;
        top: 20px;
    }

        .price-sidebar .price-tag {
            font-size: 30px;
            font-weight: 700;
            color: #e67e22;
            margin-bottom: 2px;
        }

            .price-sidebar .price-tag small {
                font-size: 13px;
                color: #999;
                font-weight: 400;
            }

        .price-sidebar .info-line {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-top: 1px solid #f0f0f0;
            font-size: 14px;
        }

            .price-sidebar .info-line .label {
                color: #888;
            }

            .price-sidebar .info-line .value {
                font-weight: 600;
                color: #1a1a1a;
            }

    .book-btn {
        width: 100%;
        background: #e67e22;
        color: #fff;
        border: none;
        padding: 13px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14.5px;
        cursor: pointer;
        margin-top: 16px;
        transition: background 0.25s ease;
    }

        .book-btn:hover {
            background: #cf6c14;
        }
</style>

<a href="/Member/ActiveTours/Index" class="back-link">
    <i class="fa fa-arrow-left" aria-hidden="true"></i> Tüm Turlara Dön
</a>

<div class="detail-hero">
    <img src="@Model.CoverImage" alt="@Model.City" />
    <div class="hero-overlay">
        <div class="hero-info">
            <h2>@Model.City</h2>
            <div class="meta-badges">
                <span><i class="fa fa-clock-o" aria-hidden="true"></i> @Model.DayNight</span>
                <span><i class="fa fa-users" aria-hidden="true"></i> @Model.Capacity kişilik</span>
            </div>
        </div>
    </div>
</div>

<div class="detail-grid">
    <div>
        <div class="detail-section">
            <h5><i class="fa fa-info-circle" aria-hidden="true"></i> Genel Bilgi</h5>
            <p>@Model.Description</p>
        </div>

        <div class="detail-section">
            <h5><i class="fa fa-map-marker" aria-hidden="true"></i> Tur Programı</h5>
            <p>@Model.Details1</p>

            <div class="second-image">
                <img src="@Model.Image2" alt="@Model.City" />
            </div>

            <p style="margin-top: 16px;">@Model.Details2</p>
        </div>
    </div>

    <div>
        <div class="price-sidebar">
            <div class="price-tag">
                ₺@Model.Price
                <small>/ kişi başı</small>
            </div>

            <div class="info-line">
                <span class="label">Süre</span>
                <span class="value">@Model.DayNight</span>
            </div>
            <div class="info-line">
                <span class="label">Kontenjan</span>
                <span class="value">@Model.Capacity kişi</span>
            </div>

            <a asp-area="Member" asp-controller="Reservation" asp-action="CreateReservation" asp-route-id="@Model.DestinationId" class="book-btn">
                <i class="fa fa-calendar-check-o mr-1" aria-hidden="true"></i> Rezervasyon Yap
            </a>
        </div>
    </div>
</div>