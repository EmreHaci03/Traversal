@model List<ResultCommentDto>

@{
    ViewData["Title"] = "Yorumlar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .page-header-row h3 {
            font-size: 20px;
            font-weight: 700;
            color: #1a1a1a;
        }

        .page-header-row p {
            font-size: 13.5px;
            color: #888;
            margin-top: 4px;
        }

    /* Export Butonları */
    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .export-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #217346;
        color: #fff;
        padding: 10px 16px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .export-btn:hover {
            background: #185c37;
            color: #fff;
            text-decoration: none;
            transform: translateY(-1px);
        }

        .export-btn.pdf {
            background: #c0392b;
            box-shadow: 0 3px 10px rgba(192, 57, 43, 0.15);
        }

            .export-btn.pdf:hover {
                background: #a93226;
                color: #fff;
                text-decoration: none;
                transform: translateY(-1px);
            }

    /* Table */
    .table-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #f8f9fb;
    }

    th {
        text-align: left;
        padding: 14px 20px;
        font-size: 12.5px;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        border-bottom: 1px solid #eee;
    }

    td {
        padding: 14px 20px;
        font-size: 14px;
        color: #333;
        border-bottom: 1px solid #f2f2f2;
        vertical-align: middle;
    }

    tbody tr:hover {
        background: #fafbfc;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    /* Comment */
    .commenter-name {
        font-weight: 700;
        color: #1a1a1a;
    }

    .comment-text {
        font-size: 12.5px;
        color: #999;
        max-width: 360px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: block;
    }

    .comment-date {
        font-size: 12.5px;
        color: #888;
    }

    .dest-badge {
        font-size: 11.5px;
        color: #2874a6;
        background: #eaf4fd;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 600;
    }

    /* Status */
    .status-badge {
        font-size: 11.5px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .status-badge.approved {
            background: #eafbea;
            color: #2e7d32;
        }

        .status-badge.pending {
            background: #fff3e6;
            color: #e67e22;
        }

    /* Actions */
    .action-btns {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 13px;
        border: none;
        cursor: pointer;
    }

        .action-btn.view {
            background: #eaf4fd;
            color: #2874a6;
        }

            .action-btn.view:hover {
                background: #2874a6;
                color: #fff;
            }

        .action-btn.approve {
            background: #eafbea;
            color: #2e7d32;
        }

            .action-btn.approve:hover {
                background: #2e7d32;
                color: #fff;
            }

        .action-btn.delete {
            background: #fdeaea;
            color: #c0392b;
        }

            .action-btn.delete:hover {
                background: #c0392b;
                color: #fff;
            }

    /* Empty */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 40px;
            color: #ddd;
            margin-bottom: 16px;
        }

        .empty-state p {
            color: #999;
            font-size: 14.5px;
        }

    /* Alerts */
    .alert-success {
        background: #eafbea;
        color: #2e7d32;
        padding: 13px 18px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background: #fdeaea;
        color: #c0392b;
        padding: 13px 18px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    /* Modal */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(20, 22, 31, 0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.active {
            display: flex;
        }

    .msg-modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 0;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        overflow: hidden;
    }

    .msg-modal-head {
        padding: 22px 26px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

        .msg-modal-head h5 {
            font-size: 16px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 4px;
        }

        .msg-modal-head .meta {
            font-size: 12.5px;
            color: #999;
        }

    .msg-modal-close {
        background: none;
        border: none;
        font-size: 18px;
        color: #aaa;
        cursor: pointer;
    }

    .msg-modal-body {
        padding: 22px 26px;
        font-size: 14px;
        color: #444;
        line-height: 1.7;
        word-break: break-word;
    }

    /* Delete Modal */
    .delete-modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 28px;
        width: 100%;
        max-width: 360px;
        text-align: center;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
    }

    .modal-icon {
        width: 56px;
        height: 56px;
        background: #fdeaea;
        color: #c0392b;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin: 0 auto 16px;
    }

    .delete-modal-box h5 {
        font-size: 16px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
    }

    .delete-modal-box p {
        font-size: 13.5px;
        color: #888;
        margin-bottom: 22px;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
    }

    .modal-btn {
        flex: 1;
        padding: 11px;
        border-radius: 9px;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
        border: none;
    }

        .modal-btn.cancel {
            background: #f5f5f5;
            color: #666;
        }

            .modal-btn.cancel:hover {
                background: #ececec;
            }

        .modal-btn.confirm {
            background: #c0392b;
            color: #fff;
        }

            .modal-btn.confirm:hover {
                background: #a5301f;
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-header-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .header-actions {
            width: 100%;
        }

        .export-btn {
            flex: 1;
        }

        .table-card {
            overflow-x: auto;
        }

        table {
            min-width: 900px;
        }
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <i class="fa fa-check-circle mr-1" aria-hidden="true"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-danger">
        <i class="fa fa-exclamation-circle mr-1" aria-hidden="true"></i>
        @TempData["Error"]
    </div>
}

<!-- SAYFA BAŞLIĞI -->
<div class="page-header-row">

    <div>
        <h3>Yorumlar</h3>
        <p>Destinasyonlara yapılan kullanıcı yorumlarını buradan yönetebilirsiniz.</p>
    </div>

    <!-- EXCEL + PDF BUTONLARI -->
    <div class="header-actions">

        <a asp-area="Admin"
           asp-controller="Comment"
           asp-action="ExportExcel"
           class="export-btn">
            <i class="fa fa-file-excel-o" aria-hidden="true"></i>
            Excel'e Aktar
        </a>

        <a asp-area="Admin"
           asp-controller="Comment"
           asp-action="ExportPdf"
           class="export-btn pdf">
            <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
            PDF'e Aktar
        </a>

    </div>

</div>

<!-- YORUM TABLOSU -->
<div class="table-card">

    @if (Model != null && Model.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>Yazan</th>
                    <th>Yorum</th>
                    <th>Destinasyon</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <span class="commenter-name">
                                @item.NameSurname
                            </span>
                        </td>

                        <td>
                            <span class="comment-text"
                                  title="@item.Content">
                                @item.Content
                            </span>
                        </td>

                        <td>
                            <span class="dest-badge">
                                #@item.DestinationId
                            </span>
                        </td>

                        <td class="comment-date">
                            @item.CommentDate.ToString("dd MMM yyyy")
                        </td>

                        <td>
                            @if (item.CommentStatus)
                            {
                                <span class="status-badge approved">
                                    <i class="fa fa-circle" style="font-size:6px;"></i>
                                    Onaylı
                                </span>
                            }
                            else
                            {
                                <span class="status-badge pending">
                                    <i class="fa fa-circle" style="font-size:6px;"></i>
                                    Beklemede
                                </span>
                            }
                        </td>

                        <td>

                            <div class="action-btns">

                                <!-- Görüntüle -->
                                <button type="button"
                                        class="action-btn view"
                                        title="Görüntüle"
                                        onclick="openViewModal(
                                                    '@item.NameSurname',
                                                    '@item.CommentDate.ToString("dd MMM yyyy")',
                                                    '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.Content))'
                                                )">

                                    <i class="fa fa-eye" aria-hidden="true"></i>

                                </button>

                                <!-- Onayla -->
                                @if (!item.CommentStatus)
                                {
                                    <form asp-area="Admin"
                                          asp-controller="Comment"
                                          asp-action="ApproveComment"
                                          asp-route-id="@item.CommentId"
                                          method="post">

                                        <button type="submit"
                                                class="action-btn approve"
                                                title="Onayla">

                                            <i class="fa fa-check"
                                               aria-hidden="true"></i>

                                        </button>

                                    </form>
                                }

                                <!-- Sil -->
                                <form asp-area="Admin"
                                      asp-controller="Comment"
                                      asp-action="DeleteComment"
                                      method="post"
                                      class="delete-form"
                                      data-name="@item.NameSurname">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.CommentId" />

                                    <button type="button"
                                            class="action-btn delete"
                                            title="Sil"
                                            onclick="openDeleteModal(this)">

                                        <i class="fa fa-trash"
                                           aria-hidden="true"></i>

                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">

            <i class="fa fa-comments-o"
               aria-hidden="true"></i>

            <p>Henüz yorum bulunmuyor.</p>

        </div>
    }

</div>

<!-- YORUM GÖRÜNTÜLEME MODALI -->
<div class="modal-overlay" id="viewModal">

    <div class="msg-modal-box">

        <div class="msg-modal-head">

            <div>
                <h5 id="viewModalName"></h5>
                <div class="meta" id="viewModalDate"></div>
            </div>

            <button type="button"
                    class="msg-modal-close"
                    onclick="closeViewModal()">

                &times;

            </button>

        </div>

        <div class="msg-modal-body"
             id="viewModalContent">
        </div>

    </div>

</div>

<!-- SİLME ONAY MODALI -->
<div class="modal-overlay" id="deleteModal">

    <div class="delete-modal-box">

        <div class="modal-icon">

            <i class="fa fa-trash"
               aria-hidden="true"></i>

        </div>

        <h5>Yorumu Sil</h5>

        <p>
            <span id="deleteModalName"></span>
            adlı kişinin yorumu silinecek.
            Bu işlem geri alınamaz.
        </p>

        <div class="modal-actions">

            <button type="button"
                    class="modal-btn cancel"
                    onclick="closeDeleteModal()">

                Vazgeç

            </button>

            <button type="button"
                    class="modal-btn confirm"
                    onclick="confirmDelete()">

                Evet, Sil

            </button>

        </div>

    </div>

</div>

@section Script {

    <script>

        // Yorum görüntüleme
        function openViewModal(name, date, content) {

            document.getElementById('viewModalName').textContent = name;

            document.getElementById('viewModalDate').textContent = date;

            document.getElementById('viewModalContent').textContent = content;

            document
                .getElementById('viewModal')
                .classList.add('active');
        }

        function closeViewModal() {

            document
                .getElementById('viewModal')
                .classList.remove('active');
        }


        // Silme modalı
        let formToDelete = null;

        function openDeleteModal(btn) {

            formToDelete = btn.closest('form');

            document.getElementById('deleteModalName').textContent =
                formToDelete.dataset.name;

            document
                .getElementById('deleteModal')
                .classList.add('active');
        }

        function closeDeleteModal() {

            document
                .getElementById('deleteModal')
                .classList.remove('active');

            formToDelete = null;
        }

        function confirmDelete() {

            if (formToDelete) {
                formToDelete.submit();
            }

        }


        // Modal dışına tıklayınca kapat
        document.addEventListener('click', function (e) {

            const viewModal =
                document.getElementById('viewModal');

            const deleteModal =
                document.getElementById('deleteModal');

            if (e.target === viewModal) {
                closeViewModal();
            }

            if (e.target === deleteModal) {
                closeDeleteModal();
            }

        });

    </script>
}