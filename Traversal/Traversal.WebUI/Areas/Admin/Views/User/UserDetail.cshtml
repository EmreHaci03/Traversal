@model GetAppUserByIdDto
@{
    ViewData["Title"] = "Kullanıcı Detayı";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<style>
    .col-lg-12 {
        width: 100%;
    }

    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .page-header-row h3 {
            font-size: 20px;
            font-weight: 700;
            color: #1a1a1a;
        }

        .page-header-row p {
            font-size: 13.5px;
            color: #888;
            margin-top: 4px;
        }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        color: #666;
        border: 1px solid #e0e0e0;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 9px;
        font-weight: 600;
        font-size: 13.5px;
    }

        .back-btn:hover {
            background: #f5f5f5;
            color: #666;
        }

    .detail-layout {
        display: grid;
        grid-template-columns: 1fr 1.6fr;
        gap: 24px;
        align-items: start;
    }

    @@media (max-width: 950px) {
        .detail-layout {
            grid-template-columns: 1fr;
        }
    }

    /* Sol - Profil Kartı */
    .profile-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .profile-banner {
        background: linear-gradient(135deg, #14161f, #262a3a);
        height: 100px;
        position: relative;
    }

        .profile-banner::after {
            content: "";
            position: absolute;
            right: -40px;
            top: -40px;
            width: 140px;
            height: 140px;
            background: rgba(230, 126, 34, 0.15);
            border-radius: 50%;
        }

    .profile-body {
        padding: 0 32px 32px;
        text-align: center;
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 5px solid #fff;
        margin-top: -50px;
        margin-bottom: 16px;
        background: #fff3e6;
        color: #e67e22;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        font-weight: 700;
        object-fit: cover;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .profile-fullname {
        font-size: 20px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 4px;
    }

    .profile-username {
        font-size: 13.5px;
        color: #999;
        margin-bottom: 20px;
    }

    .profile-actions {
        display: flex;
        gap: 8px;
    }

        .profile-actions a {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 10px;
            border-radius: 9px;
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 600;
        }

        .profile-actions .role-btn {
            background: #f3eaf8;
            color: #8e44ad;
        }

            .profile-actions .role-btn:hover {
                background: #8e44ad;
                color: #fff;
            }

    /* Sağ - Bilgi kartları */
    .info-panel {
        background: #fff;
        border-radius: 18px;
        padding: 28px 32px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 20px;
    }

        .info-panel .section-title {
            font-size: 15px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 20px;
        }

    .info-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid #f2f2f2;
    }

        .info-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .info-row:first-child {
            padding-top: 0;
        }

    .info-icon {
        width: 44px;
        height: 44px;
        background: #f8f9fb;
        color: #e67e22;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .info-row .label {
        font-size: 11.5px;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 3px;
    }

    .info-row .value {
        font-size: 14.5px;
        color: #1a1a1a;
        font-weight: 600;
        word-break: break-all;
    }

    .danger-zone {
        background: #fff;
        border-radius: 18px;
        padding: 26px 32px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #fdeaea;
    }

        .danger-zone h6 {
            font-size: 13.5px;
            font-weight: 700;
            color: #c0392b;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .danger-zone p {
            font-size: 12.5px;
            color: #999;
            margin-bottom: 16px;
        }

    .delete-btn {
        background: #fdeaea;
        color: #c0392b;
        border: none;
        padding: 11px 24px;
        border-radius: 9px;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .delete-btn:hover {
            background: #c0392b;
            color: #fff;
        }

    /* Modal */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(20, 22, 31, 0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 28px;
        width: 100%;
        max-width: 360px;
        text-align: center;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
    }

    .modal-icon {
        width: 56px;
        height: 56px;
        background: #fdeaea;
        color: #c0392b;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin: 0 auto 16px;
    }

    .modal-box h5 {
        font-size: 16px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
    }

    .modal-box p {
        font-size: 13.5px;
        color: #888;
        margin-bottom: 22px;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
    }

    .modal-btn {
        flex: 1;
        padding: 11px;
        border-radius: 9px;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
        border: none;
    }

        .modal-btn.cancel {
            background: #f5f5f5;
            color: #666;
        }

            .modal-btn.cancel:hover {
                background: #ececec;
            }

        .modal-btn.confirm {
            background: #c0392b;
            color: #fff;
        }

            .modal-btn.confirm:hover {
                background: #a5301f;
            }
</style>

<div class="col-lg-12">
    <div class="page-header-row">
        <div>
            <h3>Kullanıcı Detayı</h3>
            <p>Kullanıcı hesap bilgilerinin özeti.</p>
        </div>
        <a asp-area="Admin" asp-controller="User" asp-action="Index" class="back-btn">
            <i class="fa fa-arrow-left" aria-hidden="true"></i> Listeye Dön
        </a>
    </div>

    <div class="detail-layout">
        <div class="profile-card">
            <div class="profile-banner"></div>
            <div class="profile-body">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="profile-avatar" alt="@Model.Name" />
                }
                else
                {
                    <div class="profile-avatar">@Model.Name?.Substring(0, 1).ToUpper()</div>
                }

                <div class="profile-fullname">@Model.Name @Model.Surname</div>
                <div class="profile-username">@@@Model.UserName</div>

                <div class="profile-actions">
                    <a asp-area="Admin" asp-controller="Role" asp-action="AssignRole" asp-route-userId="@Model.AppUserId" class="role-btn">
                        <i class="fa fa-shield" aria-hidden="true"></i> Roller
                    </a>
                </div>
            </div>
        </div>

        <div>
            <div class="info-panel">
                <div class="section-title">İletişim &amp; Hesap Bilgileri</div>

                <div class="info-row">
                    <div class="info-icon"><i class="fa fa-envelope" aria-hidden="true"></i></div>
                    <div>
                        <div class="label">E-posta</div>
                        <div class="value">@Model.Email</div>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-icon"><i class="fa fa-user" aria-hidden="true"></i></div>
                    <div>
                        <div class="label">Kullanıcı Adı</div>
                        <div class="value">@Model.UserName</div>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-icon"><i class="fa fa-id-card" aria-hidden="true"></i></div>
                    <div>
                        <div class="label">Kullanıcı Kimliği</div>
                        <div class="value" style="font-size:12px; font-weight:400; color:#999;">@Model.AppUserId</div>
                    </div>
                </div>
            </div>

            <div class="danger-zone">
                <h6><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> Tehlikeli Bölge</h6>
                <p>Bu kullanıcıyı silmek, hesabını ve ilişkili tüm verilerini kalıcı olarak kaldırır. Bu işlem geri alınamaz.</p>
                <form asp-area="Admin" asp-controller="User" asp-action="DeleteUser" method="post" id="deleteUserForm">
                    <input type="hidden" name="id" value="@Model.AppUserId" />
                    <button type="button" class="delete-btn" onclick="openDeleteModal()">
                        <i class="fa fa-trash" aria-hidden="true"></i> Kullanıcıyı Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <div class="modal-icon"><i class="fa fa-trash" aria-hidden="true"></i></div>
        <h5>Kullanıcıyı Sil</h5>
        <p><strong>@Model.Name @Model.Surname</strong> hesabı kalıcı olarak silinecek. Bu işlem geri alınamaz.</p>
        <div class="modal-actions">
            <button type="button" class="modal-btn cancel" onclick="closeDeleteModal()">Vazgeç</button>
            <button type="button" class="modal-btn confirm" onclick="confirmDelete()">Evet, Sil</button>
        </div>
    </div>
</div>

@section Script {
    <script>
        function openDeleteModal() {
            document.getElementById('deleteModal').classList.add('active');
        }
        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('active');
        }
        function confirmDelete() {
            document.getElementById('deleteUserForm').submit();
        }
    </script>
}