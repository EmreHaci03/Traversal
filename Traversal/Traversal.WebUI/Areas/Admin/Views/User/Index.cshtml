@model List<ResultAppUserDto>

@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .page-header-row h3 {
            font-size: 20px;
            font-weight: 700;
            color: #1a1a1a;
            margin: 0;
        }

        .page-header-row p {
            font-size: 13.5px;
            color: #888;
            margin-top: 4px;
            margin-bottom: 0;
        }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Export Butonları */
    .export-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #fff;
        text-decoration: none;
        padding: 11px 18px;
        border-radius: 9px;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.2s ease;
    }

        /* Excel */
        .export-btn.excel {
            background: #217346;
            box-shadow: 0 3px 10px rgba(33, 115, 70, 0.15);
        }

            .export-btn.excel:hover {
                background: #185c37;
                color: #fff;
                text-decoration: none;
                transform: translateY(-1px);
            }

        /* PDF */
        .export-btn.pdf {
            background: #c0392b;
            box-shadow: 0 3px 10px rgba(192, 57, 43, 0.15);
        }

            .export-btn.pdf:hover {
                background: #a93226;
                color: #fff;
                text-decoration: none;
                transform: translateY(-1px);
            }

    .user-count-badge {
        background: #eaf4fd;
        color: #2874a6;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 20px;
    }

    /* Tablo */
    .table-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #f8f9fb;
    }

    th {
        text-align: left;
        padding: 14px 20px;
        font-size: 12.5px;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        border-bottom: 1px solid #eee;
    }

    td {
        padding: 14px 20px;
        font-size: 14px;
        color: #333;
        border-bottom: 1px solid #f2f2f2;
        vertical-align: middle;
    }

    tbody tr:hover {
        background: #fafbfc;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    /* Kullanıcı */
    .user-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        background: #fff3e6;
        color: #e67e22;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 15px;
        flex-shrink: 0;
    }

    .user-fullname {
        font-weight: 700;
        color: #1a1a1a;
    }

    .user-username {
        font-size: 12px;
        color: #999;
    }

    .user-email {
        font-size: 13px;
        color: #666;
    }

    /* İşlem Butonları */
    .action-btns {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 13px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .action-btn.edit {
            background: #eaf4fd;
            color: #2874a6;
        }

            .action-btn.edit:hover {
                background: #2874a6;
                color: #fff;
            }

        .action-btn.delete {
            background: #fdeaea;
            color: #c0392b;
        }

            .action-btn.delete:hover {
                background: #c0392b;
                color: #fff;
            }

    /* Arama */
    .search-box {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f4f5f9;
        border-radius: 9px;
        padding: 10px 14px;
        width: 280px;
        margin-bottom: 20px;
    }

        .search-box input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 13.5px;
            flex: 1;
        }

        .search-box i {
            color: #999;
            font-size: 13px;
        }

    /* Boş durum */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 40px;
            color: #ddd;
            margin-bottom: 16px;
        }

        .empty-state p {
            color: #999;
            font-size: 14.5px;
        }

    /* Alert */
    .alert-success {
        background: #eafbea;
        color: #2e7d32;
        padding: 13px 18px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background: #fdeaea;
        color: #c0392b;
        padding: 13px 18px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    /* Mobil */
    @@media (max-width: 768px) {

        .page-header-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .header-actions {
            width: 100%;
            flex-wrap: wrap;
        }

        .export-btn {
            flex: 1;
        }

        .table-card {
            overflow-x: auto;
        }

        table {
            min-width: 700px;
        }

        .search-box {
            width: 100%;
        }
    }
</style>


@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <i class="fa fa-check-circle mr-1" aria-hidden="true"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-danger">
        <i class="fa fa-exclamation-circle mr-1" aria-hidden="true"></i>
        @TempData["Error"]
    </div>
}


<!-- HEADER -->
<div class="page-header-row">

    <div>
        <h3>Kullanıcılar</h3>
        <p>Sisteme kayıtlı tüm üyeleri buradan görüntüleyebilirsiniz.</p>
    </div>

    <div class="header-actions">

        <!-- Excel -->
        <a asp-area="Admin"
           asp-controller="User"
           asp-action="ExportExcel"
           class="export-btn excel">

            <i class="fa fa-file-excel-o" aria-hidden="true"></i>

            Excel'e Aktar

        </a>


        <!-- PDF -->
        <a asp-area="Admin"
           asp-controller="User"
           asp-action="ExportPdf"
           class="export-btn pdf">

            <i class="fa fa-file-pdf-o" aria-hidden="true"></i>

            PDF'e Aktar

        </a>


        <!-- Kullanıcı Sayısı -->
        @if (Model != null && Model.Any())
        {
            <div class="user-count-badge">

                <i class="fa fa-users mr-1"
                   aria-hidden="true"></i>

                @Model.Count Kullanıcı

            </div>
        }

    </div>

</div>


<!-- TABLO -->
<div class="table-card">

    <!-- Arama -->
    <div style="padding: 20px 20px 0;">

        <div class="search-box">

            <i class="fa fa-search"
               aria-hidden="true"></i>

            <input type="text"
                   id="userSearch"
                   placeholder="Ad, kullanıcı adı veya e-posta ara..."
                   onkeyup="filterUsers()" />

        </div>

    </div>


    @if (Model != null && Model.Any())
    {
        <table id="userTable">

            <thead>

                <tr>
                    <th>Kullanıcı</th>
                    <th>Kullanıcı Adı</th>
                    <th>E-posta</th>
                    <th>İşlemler</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <!-- Kullanıcı -->
                        <td>

                            <div class="user-cell">

                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         class="user-avatar"
                                         alt="@item.Name" />
                                }
                                else
                                {
                                    <div class="user-avatar">

                                        @if (!string.IsNullOrEmpty(item.Name))
                                        {
                                            @item.Name.Substring(0, 1).ToUpper()
                                        }

                                    </div>
                                }

                                <div>

                                    <div class="user-fullname">
                                        @item.Name @item.Surname
                                    </div>

                                </div>

                            </div>

                        </td>


                        <!-- Kullanıcı Adı -->
                        <td>

                            <span class="user-username">
                                @item.UserName
                            </span>

                        </td>


                        <!-- E-posta -->
                        <td>

                            <span class="user-email">
                                @item.Email
                            </span>

                        </td>


                        <!-- İşlemler -->
                        <td>

                            <div class="action-btns">

                                <!-- Detay -->
                                <a asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="UserDetail"
                                   asp-route-userId="@item.AppUserId"
                                   class="action-btn edit"
                                   title="Detaylar">

                                    <i class="fa fa-pencil"
                                       aria-hidden="true"></i>

                                </a>

                                <!-- Kullanıcı Rolleri -->
                                <a asp-area="Admin"
                                   asp-controller="Role"
                                   asp-action="AssignRole"
                                   asp-route-userId="@item.AppUserId"
                                   class="action-btn role-assign"
                                   title="Kullanıcı Rolleri">
                                    <i class="fa fa-shield" aria-hidden="true"></i>
                                </a>


                                <!-- Sil -->
                                <form asp-area="Admin"
                                      asp-controller="User"
                                      asp-action="DeleteUser"
                                      method="post"
                                      class="delete-form"
                                      data-name="@item.Name @item.Surname">

                                    <input type="hidden"
                                           name="AppUserId"
                                           value="@item.AppUserId" />

                                    <button type="button"
                                            class="action-btn delete"
                                            title="Sil"
                                            onclick="openDeleteModal(this)">

                                        <i class="fa fa-trash"
                                           aria-hidden="true"></i>

                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <div class="empty-state">

            <i class="fa fa-users"
               aria-hidden="true"></i>

            <p>
                Henüz kayıtlı kullanıcı bulunmuyor.
            </p>

        </div>
    }

</div>


@section Script {

    <script>

        function filterUsers() {

            const input =
                document.getElementById('userSearch')
                    .value
                    .toLowerCase();

            const rows =
                document.querySelectorAll('#userTable tbody tr');

            rows.forEach(row => {

                const text =
                    row.textContent.toLowerCase();

                row.style.display =
                    text.includes(input) ? '' : 'none';

            });

        }

    </script>

}