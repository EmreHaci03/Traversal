@model CreateDestinationDto
@{
    ViewData["Title"] = "Yeni Destinasyon";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<style>
    .col-lg-12 {
        width: 100%;
    }

    .page-header-row {
        margin-bottom: 24px;
    }

        .page-header-row h3 {
            font-size: 20px;
            font-weight: 700;
            color: #1a1a1a;
        }

        .page-header-row p {
            font-size: 13.5px;
            color: #888;
            margin-top: 4px;
        }

    .form-layout {
        display: grid;
        grid-template-columns: 2.2fr 1fr;
        gap: 24px;
        align-items: start;
    }

    @@media (max-width: 950px) {
        .form-layout {
            grid-template-columns: 1fr;
        }
    }

    .form-card {
        background: #fff;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 24px;
    }

        .form-card .card-title {
            font-size: 15px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .form-card .card-title i {
                width: 34px;
                height: 34px;
                background: #fff3e6;
                color: #e67e22;
                border-radius: 9px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
            }

        .form-card .card-subtitle {
            font-size: 12.5px;
            color: #999;
            margin-bottom: 24px;
            margin-left: 44px;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    @@media (max-width: 700px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group:last-child {
            margin-bottom: 0;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: #555;
            display: block;
            margin-bottom: 7px;
        }

        .form-group .required {
            color: #e74c3c;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #e5e5e5;
            border-radius: 10px;
            font-size: 14.5px;
            transition: border-color 0.2s ease;
        }

            .form-group input:focus,
            .form-group textarea:focus {
                outline: none;
                border-color: #e67e22;
                box-shadow: 0 0 0 3px rgba(230,126,34,0.1);
            }

        .form-group textarea {
            resize: vertical;
            min-height: 110px;
        }

        .form-group .hint {
            font-size: 11.5px;
            color: #aaa;
            margin-top: 5px;
        }

    .price-input-wrap {
        position: relative;
    }

        .price-input-wrap span {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
            font-size: 14px;
            font-weight: 600;
        }

        .price-input-wrap input {
            padding-left: 32px;
        }

    .section-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 4px 0 22px;
    }

        .section-divider .num {
            width: 24px;
            height: 24px;
            background: #e67e22;
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .section-divider span {
            font-size: 12.5px;
            font-weight: 700;
            color: #cf6c14;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

    /* Önizleme kartı (sağ sütun) */
    .preview-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        position: sticky;
        top: 20px;
    }

        .preview-card .preview-label {
            padding: 16px 20px 0;
            font-size: 12px;
            font-weight: 700;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .preview-img-box {
        margin: 14px 20px 0;
        height: 160px;
        border-radius: 12px;
        background: #f4f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ccc;
        font-size: 34px;
        overflow: hidden;
    }

        .preview-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .preview-body {
        padding: 18px 20px 22px;
    }

        .preview-body h5 {
            font-size: 16px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 4px;
        }

        .preview-body p {
            font-size: 12.5px;
            color: #999;
            margin-bottom: 14px;
        }

    .preview-meta {
        display: flex;
        justify-content: space-between;
        padding-top: 14px;
        border-top: 1px solid #f0f0f0;
    }

        .preview-meta .price {
            font-size: 18px;
            font-weight: 700;
            color: #e67e22;
        }

        .preview-meta .cap {
            font-size: 12.5px;
            color: #888;
            display: flex;
            align-items: center;
            gap: 5px;
        }

    .tips-box {
        background: #fff9f2;
        border: 1px dashed #f0d4b8;
        border-radius: 14px;
        padding: 18px 20px;
        margin-top: 20px;
    }

        .tips-box h6 {
            font-size: 13px;
            font-weight: 700;
            color: #cf6c14;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tips-box ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .tips-box li {
            font-size: 12.5px;
            color: #a06a3a;
            margin-bottom: 8px;
            padding-left: 18px;
            position: relative;
        }

            .tips-box li:last-child {
                margin-bottom: 0;
            }

            .tips-box li::before {
                content: "•";
                position: absolute;
                left: 4px;
                color: #e67e22;
            }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 8px;
        padding-top: 22px;
        border-top: 1px solid #f0f0f0;
    }

    .save-btn {
        background: #e67e22;
        color: #fff;
        border: none;
        padding: 13px 34px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14.5px;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .save-btn:hover {
            background: #cf6c14;
        }

    .cancel-btn {
        background: #fff;
        color: #888;
        border: 1px solid #e0e0e0;
        padding: 13px 28px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14.5px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .cancel-btn:hover {
            background: #f5f5f5;
        }

    .text-danger {
        color: #c0392b;
        font-size: 12.5px;
        display: block;
        margin-top: 5px;
    }
</style>

<div class="col-lg-12">

    <div class="page-header-row">
        <h3>Yeni Destinasyon Ekle</h3>
        <p>Yeni bir tur/destinasyon kaydı oluşturun, bilgileri eksiksiz doldurun.</p>
    </div>

    <form asp-area="Admin" asp-controller="Destination" asp-action="CreateDestination" method="post" id="destinationForm">
      @*   <div asp-validation-summary="All" class="text-danger mb-3"></div> *@

        <div class="form-layout">
            <!-- SOL: Form alanları -->
            <div>
                <div class="form-card">
                    <div class="section-divider"><span class="num">1</span> <span>Temel Bilgiler</span></div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="City">Şehir <span class="required">*</span></label>
                            <input asp-for="City" placeholder="Örn: Paris" oninput="updatePreview()" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="DayNight">Süre <span class="required">*</span></label>
                            <input asp-for="DayNight" placeholder="Örn: 3 Gün, 4 Gece" oninput="updatePreview()" />
                            <span asp-validation-for="DayNight" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">Kısa Açıklama <span class="required">*</span></label>
                        <textarea asp-for="Description" placeholder="Kart üzerinde görünecek kısa açıklama..." style="min-height: 80px;"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                        <div class="hint">Bu açıklama, destinasyon listeleme kartlarında kullanıcıya gösterilir.</div>
                    </div>
                </div>

                <div class="form-card">
                    <div class="section-divider"><span class="num">2</span> <span>Fiyat &amp; Kapasite</span></div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Price">Fiyat <span class="required">*</span></label>
                            <div class="price-input-wrap">
                                <span>₺</span>
                                <input asp-for="Price" type="number" step="0.01" placeholder="1650" oninput="updatePreview()" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Capacity">Kapasite <span class="required">*</span></label>
                            <input asp-for="Capacity" type="number" placeholder="20" oninput="updatePreview()" />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-card">
                    <div class="section-divider"><span class="num">3</span> <span>Görseller</span></div>

                    <div class="form-group">
                        <label asp-for="Image">Kart Görseli (Image) <span class="required">*</span></label>
                        <input asp-for="Image" placeholder="https://..." oninput="updatePreview()" id="imageInput" />
                        <span asp-validation-for="Image" class="text-danger"></span>
                        <div class="hint">Liste/kart görünümünde kullanılan ana görsel.</div>
                    </div>

                    <div class="form-group">
                        <label asp-for="CoverImage">Kapak Görseli (CoverImage) <span class="required">*</span></label>
                        <input asp-for="CoverImage" placeholder="https://..." />
                        <span asp-validation-for="CoverImage" class="text-danger"></span>
                        <div class="hint">Detay sayfasının en üstündeki büyük kapak görseli.</div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Image2">İkinci Görsel (Image2)</label>
                        <input asp-for="Image2" placeholder="https://..." />
                        <span asp-validation-for="Image2" class="text-danger"></span>
                        <div class="hint">Detay sayfasında tur programı bölümünde kullanılır.</div>
                    </div>
                </div>

                <div class="form-card">
                    <div class="section-divider"><span class="num">4</span> <span>Detay Sayfası İçeriği</span></div>

                    <div class="form-group">
                        <label asp-for="Details1">Tur Programı - Bölüm 1</label>
                        <textarea asp-for="Details1" placeholder="Tur programının ilk kısmı..."></textarea>
                        <span asp-validation-for="Details1" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Details2">Tur Programı - Bölüm 2</label>
                        <textarea asp-for="Details2" placeholder="Tur programının devamı..."></textarea>
                        <span asp-validation-for="Details2" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- SAĞ: Önizleme -->
            <div>
                <div class="preview-card">
                    <div class="preview-label">Canlı Önizleme</div>
                    <div class="preview-img-box" id="previewImgBox">
                        <i class="fa fa-picture-o" aria-hidden="true"></i>
                    </div>
                    <div class="preview-body">
                        <h5 id="previewCity">Şehir adı</h5>
                        <p id="previewDayNight">Süre bilgisi</p>
                        <div class="preview-meta">
                            <div class="price" id="previewPrice">₺0</div>
                            <div class="cap"><i class="fa fa-users" aria-hidden="true"></i> <span id="previewCapacity">0</span> kişi</div>
                        </div>
                    </div>
                </div>

                <div class="tips-box">
                    <h6><i class="fa fa-lightbulb-o" aria-hidden="true"></i> İpuçları</h6>
                    <ul>
                        <li>Şehir isimlerini tam ve doğru yazın.</li>
                        <li><strong>Image</strong>: liste/kart görseli, <strong>CoverImage</strong>: detay sayfası kapak görseli.</li>
                        <li>Details1/Details2, detay sayfasında tur programı olarak gösterilir.</li>
                        <li>Görsel URL'lerinin herkese açık olduğundan emin olun.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="form-footer">
            <a asp-area="Admin" asp-controller="Destination" asp-action="Index" class="cancel-btn">Vazgeç</a>
            <button type="submit" class="save-btn"><i class="fa fa-check mr-1" aria-hidden="true"></i> Destinasyonu Kaydet</button>
        </div>
    </form>
</div>

@section Script {
    <script>
        function updatePreview() {
            const city = document.getElementById('City').value || 'Şehir adı';
            const dayNight = document.getElementById('DayNight').value || 'Süre bilgisi';
            const price = document.getElementById('Price').value || '0';
            const capacity = document.getElementById('Capacity').value || '0';
            const image = document.getElementById('imageInput').value;

            document.getElementById('previewCity').textContent = city;
            document.getElementById('previewDayNight').textContent = dayNight;
            document.getElementById('previewPrice').textContent = '₺' + price;
            document.getElementById('previewCapacity').textContent = capacity;

            const imgBox = document.getElementById('previewImgBox');
            if (image) {
                imgBox.innerHTML = '<img src="' + image + '" alt="preview" onerror="this.style.display=\'none\'" />';
            } else {
                imgBox.innerHTML = '<i class="fa fa-picture-o" aria-hidden="true"></i>';
            }
        }
    </script>
}