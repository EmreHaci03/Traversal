@model List<ResultGuideDto>

@{
    ViewData["Title"] = "Rehberler";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .page-header-row h3 {
            font-size: 20px;
            font-weight: 700;
            color: #1a1a1a;
        }

        .page-header-row p {
            font-size: 13.5px;
            color: #888;
            margin-top: 4px;
        }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Yeni Rehber */
    .add-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #e67e22;
        color: #fff;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 9px;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .add-btn:hover {
            background: #cf6c14;
            color: #fff;
            text-decoration: none;
            transform: translateY(-1px);
        }

    /* Export */
    .export-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #217346;
        color: #fff;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .export-btn:hover {
            background: #185c37;
            color: #fff;
            text-decoration: none;
            transform: translateY(-1px);
        }

        /* PDF */
        .export-btn.pdf {
            background: #c0392b;
            box-shadow: 0 3px 10px rgba(192, 57, 43, 0.15);
        }

            .export-btn.pdf:hover {
                background: #a93226;
                color: #fff;
                text-decoration: none;
                transform: translateY(-1px);
            }

    /* Table */
    .table-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #f8f9fb;
    }

    th {
        text-align: left;
        padding: 14px 20px;
        font-size: 12.5px;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        border-bottom: 1px solid #eee;
    }

    td {
        padding: 14px 20px;
        font-size: 14px;
        color: #333;
        border-bottom: 1px solid #f2f2f2;
        vertical-align: middle;
    }

    tbody tr:hover {
        background: #fafbfc;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    /* Guide */
    .guide-avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        object-fit: cover;
    }

    .guide-name {
        font-weight: 700;
        color: #1a1a1a;
    }

    .guide-desc {
        font-size: 12.5px;
        color: #999;
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: block;
    }

    /* Social */
    .social-links {
        display: flex;
        gap: 8px;
    }

        .social-links a {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 13px;
        }

        .social-links .twitter {
            background: #eaf4fd;
            color: #2874a6;
        }

        .social-links .instagram {
            background: #fdeaf3;
            color: #c0257c;
        }

        .social-links a:hover {
            opacity: 0.8;
        }

    /* Status */
    .status-badge {
        font-size: 11.5px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .status-badge.active {
            background: #eafbea;
            color: #2e7d32;
        }

        .status-badge.passive {
            background: #f2f2f2;
            color: #888;
        }

    /* Actions */
    .action-btns {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 13px;
        border: none;
        cursor: pointer;
    }

        .action-btn.edit {
            background: #eaf4fd;
            color: #2874a6;
        }

            .action-btn.edit:hover {
                background: #2874a6;
                color: #fff;
            }

        .action-btn.delete {
            background: #fdeaea;
            color: #c0392b;
        }

            .action-btn.delete:hover {
                background: #c0392b;
                color: #fff;
            }

    /* Empty */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 40px;
            color: #ddd;
            margin-bottom: 16px;
        }

        .empty-state p {
            color: #999;
            font-size: 14.5px;
        }

    /* Alert */
    .alert-success {
        background: #eafbea;
        color: #2e7d32;
        padding: 13px 18px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    /* Modal */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(20, 22, 31, 0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 28px;
        width: 100%;
        max-width: 360px;
        text-align: center;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
    }

    .modal-icon {
        width: 56px;
        height: 56px;
        background: #fdeaea;
        color: #c0392b;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin: 0 auto 16px;
    }

    .modal-box h5 {
        font-size: 16px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
    }

    .modal-box p {
        font-size: 13.5px;
        color: #888;
        margin-bottom: 22px;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
    }

    .modal-btn {
        flex: 1;
        padding: 11px;
        border-radius: 9px;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
        border: none;
    }

        .modal-btn.cancel {
            background: #f5f5f5;
            color: #666;
        }

            .modal-btn.cancel:hover {
                background: #ececec;
            }

        .modal-btn.confirm {
            background: #c0392b;
            color: #fff;
        }

            .modal-btn.confirm:hover {
                background: #a5301f;
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-header-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .header-actions {
            width: 100%;
            flex-wrap: wrap;
        }

            .header-actions a {
                flex: 1;
            }

        .table-card {
            overflow-x: auto;
        }

        table {
            min-width: 900px;
        }
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <i class="fa fa-check-circle mr-1" aria-hidden="true"></i>
        @TempData["Success"]
    </div>
}

<!-- SAYFA BAŞLIĞI -->
<div class="page-header-row">

    <div>
        <h3>Rehberler</h3>
        <p>Tur rehberlerini buradan yönetebilirsiniz.</p>
    </div>

    <!-- BUTONLAR -->
    <div class="header-actions">

        <!-- Excel -->
        <a asp-area="Admin"
           asp-controller="Guide"
           asp-action="ExportExcel"
           class="export-btn">

            <i class="fa fa-file-excel-o" aria-hidden="true"></i>
            Excel'e Aktar

        </a>

        <!-- PDF -->
        <a asp-area="Admin"
           asp-controller="Guide"
           asp-action="ExportPdf"
           class="export-btn pdf">

            <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
            PDF'e Aktar

        </a>

        <!-- Yeni Rehber -->
        <a asp-area="Admin"
           asp-controller="Guide"
           asp-action="CreateGuide"
           class="add-btn">

            <i class="fa fa-plus" aria-hidden="true"></i>
            Yeni Rehber

        </a>

    </div>

</div>

<!-- REHBER TABLOSU -->
<div class="table-card">

    @if (Model != null && Model.Any())
    {
        <table>

            <thead>
                <tr>
                    <th>Rehber</th>
                    <th>Açıklama</th>
                    <th>Sosyal Medya</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <!-- Rehber -->
                        <td>
                            <div style="display:flex; align-items:center; gap:12px;">

                                <img src="@item.Image"
                                     class="guide-avatar"
                                     alt="@item.Name" />

                                <span class="guide-name">
                                    @item.Name
                                </span>

                            </div>
                        </td>

                        <!-- Açıklama -->
                        <td>
                            <span class="guide-desc"
                                  title="@item.Description">

                                @item.Description

                            </span>
                        </td>

                        <!-- Sosyal Medya -->
                        <td>

                            <div class="social-links">

                                @if (!string.IsNullOrEmpty(item.TwitterUrl))
                                {
                                    <a href="@item.TwitterUrl"
                                       target="_blank"
                                       class="twitter"
                                       title="Twitter">

                                        <i class="fa fa-twitter"
                                           aria-hidden="true"></i>

                                    </a>
                                }

                                @if (!string.IsNullOrEmpty(item.InstagramUrl))
                                {
                                    <a href="@item.InstagramUrl"
                                       target="_blank"
                                       class="instagram"
                                       title="Instagram">

                                        <i class="fa fa-instagram"
                                           aria-hidden="true"></i>

                                    </a>
                                }

                            </div>

                        </td>

                        <!-- Durum -->
                        <td>

                            @if (item.Status)
                            {
                                <span class="status-badge active">

                                    <i class="fa fa-circle"
                                       style="font-size:6px;"></i>

                                    Aktif

                                </span>
                            }
                            else
                            {
                                <span class="status-badge passive">

                                    <i class="fa fa-circle"
                                       style="font-size:6px;"></i>

                                    Pasif

                                </span>
                            }

                        </td>

                        <!-- İşlemler -->
                        <td>

                            <div class="action-btns">

                                <!-- Düzenle -->
                                <a asp-area="Admin"
                                   asp-controller="Guide"
                                   asp-action="UpdateGuide"
                                   asp-route-id="@item.GuideId"
                                   class="action-btn edit"
                                   title="Düzenle">

                                    <i class="fa fa-pencil"
                                       aria-hidden="true"></i>

                                </a>

                                <!-- Sil -->
                                <form asp-area="Admin"
                                      asp-controller="Guide"
                                      asp-action="DeleteGuide"
                                      method="post"
                                      class="delete-form"
                                      data-name="@item.Name">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.GuideId" />

                                    <button type="button"
                                            class="action-btn delete"
                                            title="Sil"
                                            onclick="openDeleteModal(this)">

                                        <i class="fa fa-trash"
                                           aria-hidden="true"></i>

                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <div class="empty-state">

            <i class="fa fa-id-badge"
               aria-hidden="true"></i>

            <p>Henüz rehber eklenmemiş.</p>

        </div>
    }

</div>

<!-- SİLME MODALI -->
<div class="modal-overlay" id="deleteModal">

    <div class="modal-box">

        <div class="modal-icon">

            <i class="fa fa-trash"
               aria-hidden="true"></i>

        </div>

        <h5>Rehberi Sil</h5>

        <p>
            <span id="deleteModalName"></span>
            adlı rehberi silmek istediğinize emin misiniz?
            Bu işlem geri alınamaz.
        </p>

        <div class="modal-actions">

            <button type="button"
                    class="modal-btn cancel"
                    onclick="closeDeleteModal()">

                Vazgeç

            </button>

            <button type="button"
                    class="modal-btn confirm"
                    onclick="confirmDelete()">

                Evet, Sil

            </button>

        </div>

    </div>

</div>

@section Script {

    <script>

        let formToDelete = null;

        function openDeleteModal(btn) {

            formToDelete = btn.closest('form');

            document.getElementById('deleteModalName').textContent =
                formToDelete.dataset.name;

            document
                .getElementById('deleteModal')
                .classList.add('active');
        }

        function closeDeleteModal() {

            document
                .getElementById('deleteModal')
                .classList.remove('active');

            formToDelete = null;
        }

        function confirmDelete() {

            if (formToDelete) {
                formToDelete.submit();
            }

        }

        // Modal dışına tıklayınca kapat
        document.addEventListener('click', function (e) {

            const modal =
                document.getElementById('deleteModal');

            if (e.target === modal) {
                closeDeleteModal();
            }

        });

    </script>
}