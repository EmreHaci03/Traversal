@model UpdateGuideDto
@{
    ViewData["Title"] = "Rehber Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<style>
    .col-lg-12 {
        width: 100%;
    }

    .page-header-row {
        margin-bottom: 24px;
    }

        .page-header-row h3 {
            font-size: 20px;
            font-weight: 700;
            color: #1a1a1a;
        }

        .page-header-row p {
            font-size: 13.5px;
            color: #888;
            margin-top: 4px;
        }

    .form-layout {
        display: grid;
        grid-template-columns: 2.2fr 1fr;
        gap: 24px;
        align-items: start;
    }

    @@media (max-width: 950px) {
        .form-layout {
            grid-template-columns: 1fr;
        }
    }

    .form-card {
        background: #fff;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 24px;
    }

    .section-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 4px 0 22px;
    }

        .section-divider .num {
            width: 24px;
            height: 24px;
            background: #e67e22;
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
        }

        .section-divider span {
            font-size: 12.5px;
            font-weight: 700;
            color: #cf6c14;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    @@media (max-width: 700px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group:last-child {
            margin-bottom: 0;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: #555;
            display: block;
            margin-bottom: 7px;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #e5e5e5;
            border-radius: 10px;
            font-size: 14.5px;
        }

            .form-group input:focus,
            .form-group textarea:focus {
                outline: none;
                border-color: #e67e22;
                box-shadow: 0 0 0 3px rgba(230,126,34,0.1);
            }

        .form-group textarea {
            resize: vertical;
            min-height: 110px;
        }

    .preview-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        position: sticky;
        top: 20px;
        text-align: center;
        padding: 24px;
    }

        .preview-card .preview-label {
            font-size: 12px;
            font-weight: 700;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 18px;
            text-align: left;
        }

    .preview-avatar {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: #f4f5f9;
        margin: 0 auto 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ccc;
        font-size: 30px;
        overflow: hidden;
    }

        .preview-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .preview-name {
        font-size: 16px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 6px;
    }

    .preview-desc {
        font-size: 12.5px;
        color: #999;
        line-height: 1.6;
        margin-bottom: 14px;
    }

    .preview-socials {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

        .preview-socials a {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 13px;
        }

        .preview-socials .twitter {
            background: #eaf4fd;
            color: #2874a6;
        }

        .preview-socials .instagram {
            background: #fdeaf3;
            color: #c0257c;
        }

    .status-box {
        background: #fff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-top: 20px;
    }

        .status-box h6 {
            font-size: 13px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 12px;
        }

    .status-toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .status-toggle-row .status-text {
            font-size: 13px;
            color: #666;
        }

    .switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .switch .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: #e0e0e0;
            transition: 0.3s;
            border-radius: 24px;
        }

            .switch .slider::before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: 0.3s;
                border-radius: 50%;
            }

        .switch input:checked + .slider {
            background-color: #27ae60;
        }

            .switch input:checked + .slider::before {
                transform: translateX(20px);
            }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 8px;
        padding-top: 22px;
        border-top: 1px solid #f0f0f0;
    }

    .save-btn {
        background: #e67e22;
        color: #fff;
        border: none;
        padding: 13px 34px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14.5px;
        cursor: pointer;
    }

        .save-btn:hover {
            background: #cf6c14;
        }

    .cancel-btn {
        background: #fff;
        color: #888;
        border: 1px solid #e0e0e0;
        padding: 13px 28px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14.5px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .cancel-btn:hover {
            background: #f5f5f5;
        }
</style>

<div class="col-lg-12">
    <div class="page-header-row">
        <h3>Rehber Güncelle</h3>
        <p>Mevcut rehber bilgilerini düzenleyin.</p>
    </div>

    <form asp-area="Admin" asp-controller="Guide" asp-action="UpdateGuide" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="GuideId" />

        <div class="form-layout">
            <div>
                <div class="form-card">
                    <div class="section-divider"><span class="num">1</span> <span>Rehber Bilgileri</span></div>

                    <div class="form-group">
                        <label asp-for="Name">Ad Soyad</label>
                        <input asp-for="Name" oninput="updatePreview()" id="nameInput" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">Açıklama</label>
                        <textarea asp-for="Description" oninput="updatePreview()" id="descInput"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Image">Fotoğraf URL</label>
                        <input asp-for="Image" oninput="updatePreview()" id="imageInput" />
                        <span asp-validation-for="Image" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-card">
                    <div class="section-divider"><span class="num">2</span> <span>Sosyal Medya</span></div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="TwitterUrl">Twitter URL</label>
                            <input asp-for="TwitterUrl" />
                            <span asp-validation-for="TwitterUrl" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="InstagramUrl">Instagram URL</label>
                            <input asp-for="InstagramUrl" />
                            <span asp-validation-for="InstagramUrl" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-footer">
                    <a asp-area="Admin" asp-controller="Guide" asp-action="GuideList" class="cancel-btn">Vazgeç</a>
                    <button type="submit" class="save-btn"><i class="fa fa-check mr-1" aria-hidden="true"></i> Değişiklikleri Kaydet</button>
                </div>
            </div>

            <div>
                <div class="preview-card">
                    <div class="preview-label">Canlı Önizleme</div>
                    <div class="preview-avatar" id="previewAvatar">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img src="@Model.Image" alt="@Model.Name" />
                        }
                        else
                        {
                            <i class="fa fa-user" aria-hidden="true"></i>
                        }
                    </div>
                    <div class="preview-name" id="previewName">@Model.Name</div>
                    <p class="preview-desc" id="previewDesc">@Model.Description</p>
                    <div class="preview-socials">
                        <a href="#" class="twitter"><i class="fa fa-twitter" aria-hidden="true"></i></a>
                        <a href="#" class="instagram"><i class="fa fa-instagram" aria-hidden="true"></i></a>
                    </div>
                </div>

                <div class="status-box">
                    <h6>Yayın Durumu</h6>
                    <div class="status-toggle-row">
                        <span class="status-text">Sitede görünsün mü?</span>
                        <label class="switch">
                            <input type="checkbox" asp-for="Status" />
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Script {
    <script>
        function updatePreview() {
            const name = document.getElementById('nameInput').value;
            const desc = document.getElementById('descInput').value;
            const image = document.getElementById('imageInput').value;

            document.getElementById('previewName').textContent = name;
            document.getElementById('previewDesc').textContent = desc;

            const avatarBox = document.getElementById('previewAvatar');
            avatarBox.innerHTML = image
                ? '<img src="' + image + '" alt="preview" onerror="this.style.display=\'none\'" />'
                : '<i class="fa fa-user" aria-hidden="true"></i>';
        }
    </script>
}