@model RoleAssignViewModel
@{
    ViewData["Title"] = "Rol Ata";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<style>
    .col-lg-12 {
        width: 100%;
    }

    .page-header-row {
        margin-bottom: 24px;
    }

        .page-header-row h3 {
            font-size: 20px;
            font-weight: 700;
            color: #1a1a1a;
        }

        .page-header-row p {
            font-size: 13.5px;
            color: #888;
            margin-top: 4px;
        }

    .form-layout {
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        gap: 24px;
        align-items: start;
    }

    @@media (max-width: 950px) {
        .form-layout {
            grid-template-columns: 1fr;
        }
    }

    .user-card {
        background: #fff;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        text-align: center;
        position: sticky;
        top: 20px;
    }

    .user-avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #fff3e6;
        color: #e67e22;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 700;
        margin: 0 auto 14px;
    }

    .user-name {
        font-size: 16px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .user-sub {
        font-size: 12.5px;
        color: #999;
        margin-top: 4px;
    }

    .form-card {
        background: #fff;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

        .form-card .section-title {
            font-size: 15px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 4px;
        }

        .form-card .section-subtitle {
            font-size: 12.5px;
            color: #999;
            margin-bottom: 20px;
        }

    .role-check-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 16px;
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: 0.2s;
    }

        .role-check-item:hover {
            background: #fafbfc;
            border-color: #e0e0e0;
        }

        .role-check-item.checked {
            background: #fff3e6;
            border-color: #e67e22;
        }

        .role-check-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #e67e22;
            flex-shrink: 0;
        }

    .role-check-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg,#8e44ad,#a569bd);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .role-check-name {
        font-size: 14px;
        font-weight: 600;
        color: #1a1a1a;
    }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #f0f0f0;
    }

    .save-btn {
        background: #e67e22;
        color: #fff;
        border: none;
        padding: 13px 34px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14.5px;
        cursor: pointer;
    }

        .save-btn:hover {
            background: #cf6c14;
        }

    .cancel-btn {
        background: #fff;
        color: #888;
        border: 1px solid #e0e0e0;
        padding: 13px 28px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14.5px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .cancel-btn:hover {
            background: #f5f5f5;
        }
</style>

<div class="col-lg-12">
    <div class="page-header-row">
        <h3>Rol Ata</h3>
        <p>Kullanıcının sahip olduğu rolleri düzenleyin.</p>
    </div>

    <form asp-area="Admin" asp-controller="Role" asp-action="AssignRole" method="post">
        <input type="hidden" asp-for="UserId" />

        <div class="form-layout">
            <div class="user-card">
                <div class="user-avatar">@Model.UserName?.Substring(0, 1).ToUpper()</div>
                <div class="user-name">@Model.UserName</div>
                <div class="user-sub">Rolleri düzenlenecek kullanıcı</div>
            </div>

            <div class="form-card">
                <div class="section-title">Roller</div>
                <div class="section-subtitle">Kullanıcıya atamak istediğiniz rolleri işaretleyin.</div>

                @if (Model.roleChecks != null && Model.roleChecks.Any())
                {
                    for (int i = 0; i < Model.roleChecks.Count; i++)
                    {
                        var item = Model.roleChecks[i];

                        <label class="role-check-item @(item.IsSelected ? "checked" : "")">
                            <input type="hidden" asp-for="roleChecks[i].RoleId" />
                            <input type="hidden" asp-for="roleChecks[i].RoleName" />
                            <input type="checkbox" asp-for="roleChecks[i].IsSelected"
                                   onchange="this.closest('.role-check-item').classList.toggle('checked', this.checked)" />
                            <div class="role-check-icon"><i class="fa fa-shield" aria-hidden="true"></i></div>
                            <div class="role-check-name">@item.RoleName</div>
                        </label>
                    }
                }
                else
                {
                    <p style="color:#999; font-size:13px;">Tanımlı rol bulunmuyor.</p>
                }

                <div class="form-footer">
                    <a asp-area="Admin" asp-controller="User" asp-action="Index" class="cancel-btn">Vazgeç</a>
                    <button type="submit" class="save-btn"><i class="fa fa-check mr-1" aria-hidden="true"></i> Kaydet</button>
                </div>
            </div>
        </div>
    </form>
</div>