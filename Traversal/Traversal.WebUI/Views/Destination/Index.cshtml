@model List<ResultDestinationDto>
@{
    Layout = "~/Views/Shared/UI_Layout.cshtml";
}
<style>
    .grids-1 .column {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
    }

        .grids-1 .column:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
        }

        .grids-1 .column img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .grids-1 .column:hover img {
            transform: scale(1.08);
        }

    .grids-1 .info {
        padding: 20px;
    }

        .grids-1 .info h4 {
            margin-bottom: 4px;
        }

            .grids-1 .info h4 a {
                font-size: 19px;
                font-weight: 700;
                color: #1a1a1a;
                text-decoration: none;
            }

                .grids-1 .info h4 a:hover {
                    color: #e67e22;
                }

        .grids-1 .info p {
            color: #888;
            font-size: 14px;
            margin-bottom: 12px;
        }

    .grids-1 .dst-btm {
        display: flex;
        align-items: baseline;
        gap: 6px;
        border-top: 1px solid #f0f0f0;
        padding-top: 12px;
    }

        .grids-1 .dst-btm h6 {
            font-size: 11px;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0;
        }

        .grids-1 .dst-btm span {
            font-size: 22px;
            font-weight: 700;
            color: #e67e22;
        }

    .grids-1 .row > div {
        margin-bottom: 30px;
    }

    .grids-1 .detail-btn {
        display: block;
        text-align: center;
        margin-top: 16px;
        padding: 10px 0;
        background: #e67e22;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.3s ease;
    }

        .grids-1 .detail-btn:hover {
            background: #cf6c14;
            color: #fff;
        }
</style>

<section class="w3l-about-breadcrumb text-left">
    <div class="breadcrumb-bg breadcrumb-bg-about py-sm-5 py-4">
        <div class="container">
            <h2 class="title">Destinasyonlar </h2>
            <ul class="breadcrumbs-custom-path mt-2">
                <li><a href="/Default/Index/">Ana Sayfa</a></li>
                <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span> Destinasyonlar </li>
            </ul>
        </div>
    </div>
</section>
<!-- //about breadcrumb -->
<!--  Work gallery section -->
<section class="grids-1 py-5">
    <div class="grids py-lg-5 py-md-4">
        <div class="container">
            <h3 class="hny-title mb-5">Destinasyonlar</h3>
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-4 col-6">
                        <div class="column">
                            <a href="/Destination/DestinationDetail/@item.DestinationId"><img src="@item.Image" alt="" class="img-fluid"></a>
                            <div class="info">
                                <h4><a href="blog-single.html">@item.City</a></h4>
                                <p>@item.DayNight</p>
                                <div class="dst-btm">
                                    <h6 class="">Başlayan Fiyatlarla </h6>
                                    <span>₺@item.Price</span>
                                </div>
                                <a href="/Destination/DestinationDetail/@item.DestinationId" class="detail-btn">Detayları Gör</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>