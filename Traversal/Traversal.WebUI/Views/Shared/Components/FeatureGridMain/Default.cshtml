@model GetFeatureMainDto
<style>
    .maghny-gd-1.col-lg-6 .maghny-grid {
        position: relative !important;
        border-radius: 16px !important;
        overflow: hidden !important;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08) !important;
        height: 100% !important;
        min-height: 460px !important;
    }

        .maghny-gd-1.col-lg-6 .maghny-grid figure {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            height: 100% !important;
            position: relative !important;
            display: block !important;
        }

        .maghny-gd-1.col-lg-6 .maghny-grid img {
            display: block !important;
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
        }

        .maghny-gd-1.col-lg-6 .maghny-grid figcaption {
            position: absolute !important;
            bottom: 0 !important;
            left: 0 !important;
            right: 0 !important;
            top: auto !important;
            padding: 32px 28px !important;
            background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 60%, transparent 100%) !important;
            color: #fff !important;
            margin: 0 !important;
            z-index: 1 !important;
            text-align: left !important;
        }

        .maghny-gd-1.col-lg-6 .maghny-grid .badge-featured {
            position: absolute !important;
            top: 20px !important;
            left: 20px !important;
            bottom: auto !important;
            background: #e67e22 !important;
            color: #fff !important;
            font-size: 11.5px !important;
            font-weight: 700 !important;
            padding: 6px 14px !important;
            border-radius: 20px !important;
            text-transform: uppercase !important;
            letter-spacing: 0.5px !important;
            z-index: 2 !important;
        }

        .maghny-gd-1.col-lg-6 .maghny-grid figcaption h4 {
            font-size: 24px !important;
            font-weight: 700 !important;
            margin: 0 0 8px 0 !important;
            color: #fff !important;
            padding: 0 !important;
        }

        .maghny-gd-1.col-lg-6 .maghny-grid figcaption p {
            font-size: 14.5px !important;
            color: #e5e5e5 !important;
            line-height: 1.6 !important;
            margin: 0 !important;
            padding: 0 !important;
            max-width: 90% !important;
        }
</style>
<div class="maghny-gd-1 col-lg-6">
    <div class="maghny-grid">
        <span class="badge-featured"><i class="fa fa-star mr-1" aria-hidden="true"></i> Öne Çıkan</span>
        <figure>
            <img class="img-fluid" src="@Model.Image" alt="@Model.Title" />
            <figcaption>
                <h4>@Model.Title</h4>
                <p>@Model.Description</p>
            </figcaption>
        </figure>
    </div>
</div>